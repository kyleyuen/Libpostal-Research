+FILE *oracle_fp[5];
+uint64_t oracle_addr = 0;   // number of address_parser_parse calls so far; current address = oracle_addr - 1
+static int oracle_ready = 0;
+FILE *oracle_file(int k) {
+    if (!oracle_ready) {
+        oracle_ready = 1;
+        const char *d = getenv("ORACLE_DIR");
+        if (d != NULL) {
+            static const char *nm[5] = {"O1.txt", "O2.txt", "O3k.txt", "O3i.txt", "O4.txt"};
+            char p[4096];
+            for (int i = 0; i < 5; i++) { snprintf(p, sizeof p, "%s/%s", d, nm[i]); oracle_fp[i] = fopen(p, "w"); if (oracle_fp[i] == NULL) abort(); }
+        }
+    }
+    return oracle_fp[k];
+}
+void oracle_str(FILE *f, const char *s) {
+    if (s == NULL) { fputs("(null)", f); return; }
+    for (; *s; s++) {
+        unsigned char c = (unsigned char)*s;
+        if (c == '\\') fputs("\\\\", f); else if (c == '\t') fputs("\\t", f); else if (c == '\n') fputs("\\n", f); else if (c == '\r') fputs("\\r", f); else fputc(c, f);
+    }
+}
+static void oracle_member(FILE *f, phrase_array *phrases, int64_array *memberships, size_t i) {
+    int64_t m = (memberships != NULL && i < memberships->n) ? memberships->a[i] : -1;
+    if (m < 0 || phrases == NULL || (size_t)m >= phrases->n) { fputs("\t-", f); return; }
+    phrase_t ph = phrases->a[m];
+    fprintf(f, "\t%u,%u,%u", ph.start, ph.len, ph.data);
+}
