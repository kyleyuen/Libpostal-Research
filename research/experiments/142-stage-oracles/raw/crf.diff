 static inline bool crf_get_state_trans_feature_id(crf_t *self, char *feature, uint32_t *feature_id) {
     return trie_get_data(self->state_trans_features, feature, feature_id);
+}
+
+#ifdef EXP_ORACLE
+// 142 stage oracles (see address_parser.c). O3k/O3i: every key in emission order (duplicates kept) and its id or '-'.
+// O4: state row dense, state-transition row sparse (index:bits for every entry whose bits are not +0.0). fprintf only.
+FILE *oracle_file(int k);
+void oracle_str(FILE *f, const char *s);
+extern uint64_t oracle_addr;
+static inline unsigned long long oracle_bits(double d) { uint64_t u; memcpy(&u, &d, sizeof u); return (unsigned long long)u; }
+static void oracle_features(crf_t *self, cstring_array *list, char kind, uint32_t t) {
+    FILE *fk = oracle_file(2), *fi = oracle_file(3);
+    if (fk == NULL) return;
+    unsigned long long oa = (unsigned long long)oracle_addr - 1;
+    uint32_t i; char *key;
+    cstring_array_foreach(list, i, key, {
+        uint32_t id;
+        bool found = kind == 'S' ? crf_get_feature_id(self, key, &id) : crf_get_state_trans_feature_id(self, key, &id);
+        fprintf(fk, "%llu\t%u\t%c\t%u\t", oa, t, kind, i); oracle_str(fk, key); fputc('\n', fk);
+        if (found) fprintf(fi, "%llu\t%u\t%c\t%u\t%u\n", oa, t, kind, i, id); else fprintf(fi, "%llu\t%u\t%c\t%u\t-\n", oa, t, kind, i);
+    })
+}
+static void oracle_scores(crf_t *self, crf_context_t *ctx, uint32_t t) {
+    FILE *f = oracle_file(4);
+    if (f == NULL) return;
+    unsigned long long oa = (unsigned long long)oracle_addr - 1;
+    size_t L = self->num_classes;
+    double *s = state_score(ctx, t), *st = state_trans_score_all(ctx, t);
+    fprintf(f, "%llu\t%u\tS", oa, t);
+    for (size_t c = 0; c < L; c++) fprintf(f, "\t%016llx", oracle_bits(s[c]));
+    fprintf(f, "\n%llu\t%u\tT", oa, t);
+    for (size_t c = 0; c < L * L; c++) if (oracle_bits(st[c]) != 0) fprintf(f, "\t%zu:%016llx", c, oracle_bits(st[c]));
+    fputc('\n', f);
 }
+#endif
 
