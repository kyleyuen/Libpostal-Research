+                    trie_concat_char(prefix, prefix_len, suffix, suffix_len, tail_pos + i)) return false;
+            }
+            *data = entry.data;
+            return true;
+        }
+        node_id = next_id;
+    }
+    return trie_get_data_at_index(self, next_id, data);
