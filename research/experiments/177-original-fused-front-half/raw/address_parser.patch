+/* 177: one front-half record is produced after normalization and phrase search,
+   then consumed directly by feature generation. It carries only identities the
+   old feature function reads independently: normalized word and three phrase
+   memberships. The parser remains single-threaded; allocation failure falls
+   back to the original context arrays. */
+typedef struct { char *word; int64_t address, component, postal; } ap_front_t;
+static ap_front_t *ap_front = NULL;
+static size_t ap_front_cap = 0, ap_front_n = 0;
+static bool ap_front_fill(address_parser_context_t *c) {
+    size_t n = c->normalized_tokens->n;
+    if (n > ap_front_cap) { ap_front_t *p = realloc(ap_front, n * sizeof(*p)); if (!p) { ap_front_n = 0; return false; } ap_front = p; ap_front_cap = n; }
+    for (size_t i = 0; i < n; i++) ap_front[i] = (ap_front_t){ cstring_array_get_string(c->normalized, i), c->address_phrase_memberships->a[i], c->component_phrase_memberships->a[i], c->postal_code_phrase_memberships->a[i] };
+    ap_front_n = n; return true;
+}
