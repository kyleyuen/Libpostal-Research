+// Experiment 105. trie_word_falls_off: does the byte loop below, walking w from the root in a fresh state, take the "fell off trie" branch inside w (same
+// transitions and test; a tail or the end of w is "no")? The address parser stores the answer for every vocabulary word in bit 60 of its 056 entry
+// (postcode trie) and passes each admin token's slot. A flagged token in the fresh state (EXP_PHRASE_PREFILTER's condition) would fall off, after which the
+// original takes the NO_MATCH branch with no match pending: phrase_start = phrase_len = 0 and the walk restarts at the start node. The skip sets exactly that.
+bool trie_word_falls_off(trie_t *self, const char *w, size_t len) {
+    trie_node_t node = trie_get_node(self, ROOT_NODE_ID), last_node = node; uint32_t node_id = ROOT_NODE_ID, last_node_id = ROOT_NODE_ID;
+    if (node.base < 0 || len == 0) return false;
+    for (size_t j = 0; j < len; j++) {
+        node_id = trie_get_transition_index(self, node, (unsigned char)w[j]); node = trie_get_node(self, node_id);
+        if (node.check != (int32_t)last_node_id && last_node.base >= 0) return true;
+        if (node.base < 0) return false;
+        last_node = node; last_node_id = node_id;
+    }
+    return false;
+}
