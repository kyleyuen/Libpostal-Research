+// resolves the plain-text keys a[from..) into slots appended to rec_emit[w]
+static bool rec_resolve_strings(cstring_array *a, size_t from, int w) {
+    size_t n = a->indices->n; char *chars = a->str->a; uint32_t *off = a->indices->a; size_t chars_n = a->str->n;
+    if (!rec_emit_reserve(w, rec_emit_n[w] + (n - from))) return false;
+    for (size_t i = from; i < n; i++) {
+        size_t len = (i + 1 < n ? off[i + 1] : chars_n) - off[i] - 1;
+        rec_emit[w][rec_emit_n[w]++] = rec_lookup_str(w ? 'P' : 'S', chars + off[i], len);
+    }
