+static inline void rec_add_row(double *scores, const uint8_t *s) {
+    uint32_t n = slot_nnz(s); const double *v = slot_values(s);
+    if (s[1] == 'S') { const uint8_t *lab = s + 4; for (uint32_t c = 0; c < n; c++) scores[lab[c]] += v[c]; }
+    else { const uint8_t *lab = s + 4; for (uint32_t c = 0; c < n; c++) { uint16_t l; memcpy(&l, lab + 2 * c, 2); scores[l] += v[c]; } }
+}
+static inline void rec_prefetch_slot(const uint8_t *s) {
+    if (s == NULL) return;
+    if (s[1] == 'S') { __builtin_prefetch(s); return; }
+    const char *a = (const char *)s, *b = (const char *)slot_next(s); int c = 0;   // transition rows: every 128-byte line, up to 8 (as cpi's EXP_ROW_LINES)
+    for (uintptr_t q = (uintptr_t)a & ~(uintptr_t)127; q < (uintptr_t)b && c < 8; q += 128, c++) __builtin_prefetch((const void *)q);
