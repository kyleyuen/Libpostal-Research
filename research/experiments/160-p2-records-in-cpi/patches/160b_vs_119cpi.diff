diff -ruN ../../final/119-cpi/sources/rec_format.h sources/rec_format.h
--- ../../final/119-cpi/sources/rec_format.h	1969-12-31 16:00:00
+++ sources/rec_format.h	2026-10-05 17:32:33
@@ -0,0 +1,91 @@
+// Experiment 160 (P2): compiled-record file shared by the offline generator (tools/gen_records.c) and the parser (EXP_RECORDS).
+// One header for both sides, so the grouping rule and the index hash cannot drift apart.
+//
+// Grouping rule (153's a2_records.c, unchanged): a model feature key "family|value" lives in one record keyed by a string the parser has:
+//   unit  'U'+value   families word, prev word, next word, first word, phrase, sub_word, prefix, suffix, postcode have context,
+//                     postcode no context, commonly *; "phrase type+phrase|T|P" and "unambiguous phrase type+phrase|T|P" have
+//                     unit P and family "<name>|T"
+//   pair  'B'+value   prev word+word, word+next word (value = "a|b" exactly as joined)
+//   own   'K'+key     everything else, family "own"
+// The vocabulary frequency of word w sits in the unit record 'U'+w (vord != REC_NOVOCAB marks a vocabulary key).
+// The map key -> (record key, family, kind) is injective (key = family "|" value for U/B, the record key itself for K), so a
+// lookup hits iff the exact key is a model key.
+//
+// File: rec_header_t | family table | arena (16 KiB aligned) | index (16 KiB aligned) | vocabulary list (u32 record offset / 8 per vocab ordinal)
+// Record (8-aligned): u32 freq | u32 vord | u16 nslots | u16 keylen | key (keylen bytes, first byte = U/B/K) | pad to 8 | slots
+// Slot (8-aligned):   u8 family | u8 kind ('S' state, 'P' transition) | u16 nnz | labels (u8 per entry for S, u16 for P) | pad to 8 | f64 x nnz
+// Slots of a record are sorted by (kind, family). Values are the model's doubles, bit for bit, in the model's row order.
+// Index: power-of-two open addressing, linear probing, u64 entries = (hash >> 32) << 32 | (record offset / 8 + 1); 0 = empty.
+#ifndef REC_FORMAT_H
+#define REC_FORMAT_H
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+
+#define REC_MAGIC "LPREC160"
+#define REC_VERSION 1u
+#define REC_NOVOCAB 0xFFFFFFFFu
+#define REC_HDR 12u          // record header bytes before the key
+
+typedef struct {
+    char magic[8];
+    uint32_t version, nfam;
+    uint64_t nrec, nslot, nvocab;
+    uint64_t fam_off, fam_bytes;
+    uint64_t arena_off, arena_bytes;
+    uint64_t index_off, index_slots;
+    uint64_t vlist_off;
+    uint64_t model_size, vocab_size;   // byte sizes of address_parser_crf.dat / address_parser_vocab.trie (cheap fingerprint)
+    uint64_t file_size;
+} rec_header_t;
+
+// 8-byte-chunk multiplicative hash of (prefix byte, bytes); the prefix is folded into the seed so no joined copy is needed.
+static inline uint64_t rec_hash(char pfx, const char *s, size_t n) {
+    uint64_t h = 0x9E3779B97F4A7C15ull ^ ((uint64_t)(uint8_t)pfx << 56) ^ n;
+    while (n >= 8) { uint64_t w; memcpy(&w, s, 8); h = (h ^ w) * 0xff51afd7ed558ccdull; h ^= h >> 32; s += 8; n -= 8; }
+    uint64_t w = 0;
+    if (n >= 4) { uint32_t a, b; memcpy(&a, s, 4); memcpy(&b, s + n - 4, 4); w = (uint64_t)a | ((uint64_t)b << 32); }
+    else if (n) { w = (uint8_t)s[0] | ((uint64_t)(uint8_t)s[n / 2] << 8) | ((uint64_t)(uint8_t)s[n - 1] << 16); }
+    h = (h ^ w) * 0xc4ceb9fe1a85ec53ull; h ^= h >> 29; return h;
+}
+
+static inline int rec_is_unit_family(const char *f, size_t n) {
+    static const char *u[] = { "word", "prev word", "next word", "first word", "phrase", "sub_word", "prefix", "suffix",
+                               "postcode have context", "postcode no context", NULL };
+    for (int i = 0; u[i]; i++) if (strlen(u[i]) == n && !memcmp(u[i], f, n)) return 1;
+    return n > 9 && !memcmp(f, "commonly ", 9);
+}
+
+// Groups a plain-text feature key. Out: record prefix, record value (*rk, *rkl; without the prefix byte), family name (*fam, *fl).
+// The family name is either a prefix of `key` or the literal "own".
+static inline void rec_group(const char *key, size_t kl, char *pfx, const char **rk, size_t *rkl, const char **fam, size_t *fl) {
+    const char *bar = (const char *)memchr(key, '|', kl);
+    if (!bar) { *pfx = 'K'; *rk = key; *rkl = kl; *fam = "own"; *fl = 3; return; }
+    size_t f = (size_t)(bar - key); const char *arg = bar + 1; size_t al = kl - f - 1;
+    if ((f == 18 && !memcmp(key, "phrase type+phrase", 18)) || (f == 30 && !memcmp(key, "unambiguous phrase type+phrase", 30))) {
+        const char *b2 = (const char *)memchr(arg, '|', al);
+        if (!b2) { *pfx = 'K'; *rk = key; *rkl = kl; *fam = "own"; *fl = 3; return; }
+        size_t tl = (size_t)(b2 - arg);
+        *pfx = 'U'; *rk = b2 + 1; *rkl = al - tl - 1; *fam = key; *fl = f + 1 + tl; return;
+    }
+    if (f == 14 && (!memcmp(key, "prev word+word", 14) || !memcmp(key, "word+next word", 14))) { *pfx = 'B'; *rk = arg; *rkl = al; *fam = key; *fl = f; return; }
+    if (rec_is_unit_family(key, f)) { *pfx = 'U'; *rk = arg; *rkl = al; *fam = key; *fl = f; return; }
+    *pfx = 'K'; *rk = key; *rkl = kl; *fam = "own"; *fl = 3;
+}
+
+// Record accessors (r points at a record header in the arena)
+static inline uint32_t rec_freq(const uint8_t *r) { uint32_t v; memcpy(&v, r, 4); return v; }
+static inline uint32_t rec_vord(const uint8_t *r) { uint32_t v; memcpy(&v, r + 4, 4); return v; }
+static inline uint16_t rec_nslots(const uint8_t *r) { uint16_t v; memcpy(&v, r + 8, 2); return v; }
+static inline uint16_t rec_keylen(const uint8_t *r) { uint16_t v; memcpy(&v, r + 10, 2); return v; }
+static inline const uint8_t *rec_first_slot(const uint8_t *r) { return r + ((REC_HDR + rec_keylen(r) + 7u) & ~7u); }
+static inline uint16_t slot_nnz(const uint8_t *s) { uint16_t v; memcpy(&v, s + 2, 2); return v; }
+static inline const double *slot_values(const uint8_t *s) { uint32_t n = slot_nnz(s); return (const double *)(s + ((4u + (s[1] == 'S' ? n : 2u * n) + 7u) & ~7u)); }
+static inline const uint8_t *slot_next(const uint8_t *s) { return (const uint8_t *)(slot_values(s) + slot_nnz(s)); }
+static inline const uint8_t *rec_slot(const uint8_t *r, uint8_t fam, uint8_t kind) {
+    if (r == NULL) return NULL;
+    const uint8_t *s = rec_first_slot(r);
+    for (uint32_t q = 0, ns = rec_nslots(r); q < ns; q++, s = slot_next(s)) if (s[0] == fam && s[1] == kind) return s;
+    return NULL;
+}
+#endif
diff -ruN ../../final/119-cpi/sources/rec_runtime.h sources/rec_runtime.h
--- ../../final/119-cpi/sources/rec_runtime.h	1969-12-31 16:00:00
+++ sources/rec_runtime.h	2026-10-05 18:02:35
@@ -0,0 +1,104 @@
+// Experiment 160 (P2, EXP_RECORDS): parser-side access to the compiled-record file (format: rec_format.h).
+// The file is produced offline from the model by tools/gen_records.c, memory-mapped read-only at setup and prefaulted there.
+// Globals are defined once in crf.c (REC_RUNTIME_DEFINE); address_parser.c uses the same ones.
+#ifndef REC_RUNTIME_H
+#define REC_RUNTIME_H
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <time.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include "rec_format.h"
+
+// ponytail: the default path is this experiment's artifact (a C literal, so the spaces never pass through the shell);
+// LIBPOSTAL_RECORDS_FILE overrides it. A packaged build would place the file next to the model instead.
+#define REC_DEFAULT_PATH "/Users/kyle/Desktop/HW/CSCI 201 Reserach/research/experiments/160-p2-records-in-cpi/artifacts/records/address_parser_records.dat"
+
+typedef struct {
+    const uint8_t *map; size_t map_size;
+    const uint8_t *ar; const uint64_t *idx; uint64_t mask;
+    const uint32_t *vlist; uint64_t nvocab, nrec, nslot;
+    uint32_t nfam; const char *fam_name[256]; uint8_t fam_len[256];
+    double open_seconds;
+} rec_db_t;
+#ifdef REC_RUNTIME_DEFINE
+rec_db_t rec_db;
+#else
+extern rec_db_t rec_db;
+#endif
+#define REC_NONE 0xFFu
+
+static inline bool rec_ready(void) { return rec_db.ar != NULL; }
+
+static inline const uint8_t *rec_find_h(char pfx, const char *s, size_t n, uint64_t h) {
+    const uint64_t *idx = rec_db.idx; uint64_t mask = rec_db.mask, pos = h & mask, tag = h >> 32;
+    for (;; pos = (pos + 1) & mask) {
+        uint64_t e = idx[pos];
+        if (!e) return NULL;
+        if ((e >> 32) == tag) {
+            const uint8_t *c = rec_db.ar + ((e & 0xffffffffu) - 1) * 8;
+            if (rec_keylen(c) == n + 1 && c[REC_HDR] == (uint8_t)pfx && memcmp(c + REC_HDR + 1, s, n) == 0) return c;
+        }
+    }
+}
+static inline const uint8_t *rec_find(char pfx, const char *s, size_t n) { return rec_find_h(pfx, s, n, rec_hash(pfx, s, n)); }
+
+// family code of a name, REC_NONE if no model key uses it (then every lookup of that family misses, as in the original)
+static inline uint8_t rec_fam(const char *name, size_t n) {
+    for (uint32_t i = 0; i < rec_db.nfam; i++) if (rec_db.fam_len[i] == n && memcmp(rec_db.fam_name[i], name, n) == 0) return (uint8_t)i;
+    return REC_NONE;
+}
+
+// Slot of a plain-text feature key ('S' state / 'P' transition), NULL iff the original dictionary lookup misses.
+static inline const uint8_t *rec_lookup_str(uint8_t kind, const char *key, size_t kl) {
+    char pfx; const char *rk, *fam; size_t rkl, fl;
+    rec_group(key, kl, &pfx, &rk, &rkl, &fam, &fl);
+    uint8_t f = rec_fam(fam, fl);
+    if (f == REC_NONE) return NULL;
+    return rec_slot(rec_find(pfx, rk, rkl), f, kind);
+}
+
+// vocabulary count of exactly these bytes (0 when absent), as trie_get_data on the vocabulary trie returns it
+static inline uint32_t rec_vocab_freq(const char *s, size_t n) { const uint8_t *r = rec_find('U', s, n); return r ? rec_freq(r) : 0; }
+
+static inline uint64_t rec_file_size(const char *path) { struct stat st; return stat(path, &st) == 0 ? (uint64_t)st.st_size : 0; }
+
+static inline void rec_close(void) {
+    if (rec_db.map != NULL) munmap((void *)rec_db.map, rec_db.map_size);
+    memset(&rec_db, 0, sizeof rec_db);
+}
+
+// Maps the record file, checks it against the model files in dir (cheap fingerprint: sizes), prefaults every page. false on any doubt.
+static inline bool rec_open(const char *dir) {
+    struct timespec t0, t1; clock_gettime(CLOCK_MONOTONIC, &t0);
+    rec_close();
+    const char *path = getenv("LIBPOSTAL_RECORDS_FILE"); if (path == NULL) path = REC_DEFAULT_PATH;
+    int fd = open(path, O_RDONLY); struct stat st;
+    if (fd < 0 || fstat(fd, &st) != 0 || (size_t)st.st_size < sizeof(rec_header_t)) { if (fd >= 0) close(fd); fprintf(stderr, "EXP_RECORDS: cannot open %s\n", path); return false; }
+    const uint8_t *m = (const uint8_t *)mmap(NULL, (size_t)st.st_size, PROT_READ, MAP_PRIVATE, fd, 0); close(fd);
+    if (m == MAP_FAILED) { fprintf(stderr, "EXP_RECORDS: mmap failed\n"); return false; }
+    rec_header_t H; memcpy(&H, m, sizeof H);
+    char p[4096];
+    snprintf(p, sizeof p, "%s/address_parser_crf.dat", dir); uint64_t ms = rec_file_size(p);
+    snprintf(p, sizeof p, "%s/address_parser_vocab.trie", dir); uint64_t vs = rec_file_size(p);
+    if (memcmp(H.magic, REC_MAGIC, 8) != 0 || H.version != REC_VERSION || H.file_size != (uint64_t)st.st_size || H.model_size != ms || H.vocab_size != vs ||
+        H.index_slots == 0 || (H.index_slots & (H.index_slots - 1)) != 0 || H.nfam > 255) {
+        munmap((void *)m, (size_t)st.st_size); fprintf(stderr, "EXP_RECORDS: %s does not match the model in %s\n", path, dir); return false;
+    }
+    madvise((void *)m, (size_t)st.st_size, MADV_WILLNEED);
+    volatile uint8_t sink = 0; for (size_t o = 0; o < (size_t)st.st_size; o += 16384) sink ^= m[o];   // prefault at setup, not in the first parse
+    (void)sink;
+    rec_db.map = m; rec_db.map_size = (size_t)st.st_size;
+    rec_db.ar = m + H.arena_off; rec_db.idx = (const uint64_t *)(m + H.index_off); rec_db.mask = H.index_slots - 1;
+    rec_db.vlist = (const uint32_t *)(m + H.vlist_off); rec_db.nvocab = H.nvocab; rec_db.nfam = H.nfam; rec_db.nrec = H.nrec; rec_db.nslot = H.nslot;
+    const uint8_t *f = m + H.fam_off;
+    for (uint32_t i = 0; i < H.nfam; i++) { rec_db.fam_len[i] = f[0]; rec_db.fam_name[i] = (const char *)f + 1; f += 1 + f[0]; }
+    clock_gettime(CLOCK_MONOTONIC, &t1); rec_db.open_seconds = (t1.tv_sec - t0.tv_sec) + (t1.tv_nsec - t0.tv_nsec) / 1e9;
+    if (getenv("REC_VERBOSE") != NULL) fprintf(stderr, "EXP_RECORDS: %s records=%llu slots=%llu vocab=%llu families=%u file=%.1f MB open+prefault=%.2fs\n", path,
+        (unsigned long long)H.nrec, (unsigned long long)H.nslot, (unsigned long long)H.nvocab, H.nfam, st.st_size / 1e6, rec_db.open_seconds);
+    return true;
+}
+#endif
