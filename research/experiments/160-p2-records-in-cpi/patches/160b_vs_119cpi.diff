+const uint8_t **rec_emit[2] = {NULL, NULL}; size_t rec_emit_n[2] = {0, 0}, rec_emit_m[2] = {0, 0};
+static uint32_t *rec_tok[2] = {NULL, NULL}; static size_t rec_tok_m = 0;
+static bool rec_emit_reserve(int w, size_t n) {
+    if (n <= rec_emit_m[w]) return true;
+    size_t m = rec_emit_m[w] ? rec_emit_m[w] : 256; while (m < n) m *= 2;
+    const uint8_t **p = realloc(rec_emit[w], m * sizeof *p); if (p == NULL) return false;
+    rec_emit[w] = p; rec_emit_m[w] = m; return true;
