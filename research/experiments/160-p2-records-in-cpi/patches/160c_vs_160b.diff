+static inline void rd_push(int w, const uint8_t *slot) {
+    if (rec_emit_n[w] == rec_emit_m[w] && !rec_emit_reserve(w, rec_emit_n[w] + 1)) { fprintf(stderr, "rec_direct: out of memory\n"); abort(); }
