+    }
+    case RD_OWN: {
+        size_t kl = rd_join(0, count, part, len); uint8_t f = rec_fam("own", 3);
+        rd_push(w, f == REC_NONE ? NULL : rec_slot(rec_find_memo('K', rd_buf, kl), f, kind)); return;
+    }
+    default: break;
+    }
+    size_t kl = rd_join(0, count, part, len);                                 // generic: the full key through rec_group, as stage B
+    rd_push(w, rec_lookup_str(kind, rd_buf, kl));
+}
