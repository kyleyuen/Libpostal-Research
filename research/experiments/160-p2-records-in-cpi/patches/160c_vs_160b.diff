+#ifdef EXP_RECORDS_DIRECT
+// 160c: records found during ONE address's feature pass, so neighbour words (word / prev word / next word / vocabulary frequency of the
+// same token) reuse the record instead of probing the 268 MB index again. A hit is returned only after its key bytes compare equal, so
+// the result is exactly rec_find's; misses are not memoized. rec_memo_gen is bumped before every address (crf.c), so no entry survives
+// into the next address; entries are only consulted while rec_direct_on (inside that address's accumulate loop).
+typedef struct { const uint8_t *rec; uint32_t gen, tag; } rec_memo_t;
+#define REC_MEMO_N 1024   // ponytail: direct-mapped; a collision just costs a normal lookup
+extern rec_memo_t rec_memo[REC_MEMO_N]; extern uint32_t rec_memo_gen; extern int rec_direct_on; extern const void *rec_direct_arr[2];
+#ifdef EXP_RECORDS_ORACLE
+extern unsigned long long rec_dstat[8];   // diagnostic build only: [0..4] classes 1..5, [5] memo hits, [6] index lookups, [7] index hits
+#define REC_DSTAT(i) (rec_dstat[(i)]++)
+#else
+#define REC_DSTAT(i) ((void)0)
+#endif
+static inline const uint8_t *rec_find_memo(char pfx, const char *s, size_t n) {
+    uint64_t h = rec_hash(pfx, s, n); rec_memo_t *e = &rec_memo[(h >> 7) & (REC_MEMO_N - 1)];
+    if (e->gen == rec_memo_gen && e->tag == (uint32_t)h) {
+        const uint8_t *c = e->rec;
+        if (rec_keylen(c) == n + 1 && c[REC_HDR] == (uint8_t)pfx && memcmp(c + REC_HDR + 1, s, n) == 0) { REC_DSTAT(5); return c; }
+    }
+    REC_DSTAT(6);
+    const uint8_t *r = rec_find_h(pfx, s, n, h);
+    if (r != NULL) REC_DSTAT(7);
+    if (r != NULL) { e->rec = r; e->gen = rec_memo_gen; e->tag = (uint32_t)h; }
+    return r;
+}
