+enum { RD_GENERIC = 1, RD_OWN, RD_UNIT, RD_PAIR, RD_PTYPE };
+static int rd_classify(size_t count, const char *name, size_t nl, uint8_t *fam) {
+    *fam = REC_NONE;
+    if (nl == 0 || memchr(name, '|', nl) != NULL) return RD_GENERIC;          // rec_group would split inside the name
+    if (count == 1) return RD_OWN;                                            // key == name, no '|': an own key
+    if ((nl == 18 && !memcmp(name, "phrase type+phrase", 18)) || (nl == 30 && !memcmp(name, "unambiguous phrase type+phrase", 30)))
+        return count == 3 ? RD_PTYPE : RD_GENERIC;
+    if (nl == 14 && (!memcmp(name, "prev word+word", 14) || !memcmp(name, "word+next word", 14))) { *fam = rec_fam(name, nl); return RD_PAIR; }
+    if (rec_is_unit_family(name, nl)) { *fam = rec_fam(name, nl); return RD_UNIT; }
+    return RD_OWN;
