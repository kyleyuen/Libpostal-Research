+    case RD_UNIT: case RD_PAIR: {
+        if (fam == REC_NONE) { rd_push(w, NULL); return; }                  // no model key has this family: the original lookup misses
+        const char *v; size_t vl;
+        if (count == 2) { v = part[1]; vl = len[1]; } else { vl = rd_join(1, count, part, len); v = rd_buf; }
