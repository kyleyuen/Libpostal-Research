+
+#ifdef EXP_RW_BIGRAM
+// 146: "\x01" placeholders carry a pre-resolved bigram id (or RW_MISS) on a per-token side channel, in emission order.
+uint32_t rw_side_get(size_t k);
+static inline bool crf_state_id(crf_t *self, char *feature, uint32_t *id, size_t *k) {
+    if (feature[0] == '\x01') { uint32_t v = rw_side_get((*k)++); if (v == UINT32_MAX) return false; *id = v; return true; }
+    return crf_get_feature_id(self, feature, id);
+}
+#else
+static inline bool crf_state_id(crf_t *self, char *feature, uint32_t *id, size_t *k) { (void)k; return crf_get_feature_id(self, feature, id); }
+#endif
 
