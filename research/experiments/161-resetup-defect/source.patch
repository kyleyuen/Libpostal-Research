+// Experiment 161: teardown-only. Every file-scope value that address_parser_load (or a parse) derives from the loaded model goes back to its initial
+// state, so the next setup rebuilds it from the model it loads. Called by address_parser_destroy for the module's parser. Per-address scratch with no
+// model data (ap_wm, ap_vm, ap_pm, rs_*, ftt_slots) keeps its capacity; its contents are rebuilt for every address.
+static void ap_statics_reset(void) {
+#ifdef EXP_CP_IDS
+    free(cp_start); free(cp_cnt); free(cp_len); free(cp_pool);   // cp_pool_m was left at the pre-shrink capacity: re-setup wrote past cp_pool
+    cp_start = cp_pool = NULL; cp_cnt = cp_len = NULL; cp_n = cp_pool_n = cp_pool_m = 0; cp_ready = false; cp_dict = NULL;
+    if (cp_tmp != NULL) { cstring_array_destroy(cp_tmp); cp_tmp = NULL; }
+#endif
+#ifdef EXP_FTT
+    free((void *)trie_ftt_tab); trie_ftt_tab = NULL; trie_ftt_trie = NULL; trie_ftt_slot = NULL; trie_ftt_n = 0;   // the table leaked before
+#endif
+#ifdef EXP_CANON_CONST
+    ap_canon_unknown = ap_canon_unknown_numeric = 0xFFFFFFFFu; ap_canon_const_ready = false;
+#endif
+#ifdef EXP_NORM_TABLE
+    free(nt_table); nt_table = NULL; nt_state = 0;   // rebuilt by the next setup from the transliteration state then current
+#endif
+#ifdef EXP_PC_COMPRESS
+    pc_rows = 0; pc_m = pc_n = 0;                    // pc_bytes/pc_off/pc_on are already cleared in address_parser_destroy
+#endif
+}
