+// Experiment 161: teardown-only. Every file-scope value that setup or a parse derives from the loaded model goes back to its initial state, so a
+// later setup (any datadir) starts exactly like the first one. Per-address scratch with no model data (crf_feature_ids, crf_state/trans_ids/tok,
+// the batch arrays) keeps its capacity; it is rebuilt for every address.
+static void crf_statics_reset(void) {
+#ifdef EXP_LEAN_CONTEXT
+    crf_lean_cap_items = 0;                       // the next context is new (CRF_CONTEXT_DEFAULT_NUM_ITEMS rows); a stale capacity skipped its resize
+#endif
+#ifdef EXP_INT_KEYS
+    crf_ik_active = 0;
+    for (int w = 0; w < 2; w++) {
+        free(crf_ik_keys[w]); crf_ik_keys[w] = NULL; crf_ik_n[w] = crf_ik_m[w] = 0;
+        for (int r = 0; r < 6; r++) crf_ik_name[w][r] = -1;
+    }
+#ifdef EXP_ROLE_IDS
+    free(crf_role_ids); crf_role_ids = NULL;      // was leaked and kept answering after its dictionaries were freed
+#endif
+#ifdef EXP_CONST_IDS
+    crf_const_ready = 0; crf_const_ids[0] = crf_const_ids[1] = CRF_NO_FEATURE;
+#endif
+#endif
+#ifdef EXP_BACK_NOCLEAR
+    crf_weights_finite = 0;
+#endif
+}
+#if defined(EXP_FEATURE_DICT) && defined(EXP_NAME_BYTE)
+// The per-call-site name caches of features.c (fa_nb_cache_t) are keyed by dictionary address. Freeing a dictionary would let a later setup's
+// dictionary reuse the address and match a stale cache entry (wrong name id if that setup loads a different model). So the contents are freed and
+// the header is kept, which makes every dictionary address unique for the life of the process.
+// ponytail: leaks 2 headers (~7 KB) per teardown; a cache-invalidation hook in features.c would avoid it but touches the parse path.
+static void crf_dict_retire(feature_dict_t *d) {
+    if (d == NULL) return;
+    for (uint32_t i = 0; i < d->num_names; i++) free(d->names[i].str);
+    free(d->slots);
+#ifdef EXP_INT_KEYS
+    free(d->islots);
+#endif
+    if (d->arena) munmap(d->arena, d->arena_map);
+    memset(d, 0, sizeof *d);
+}
+#endif
+
