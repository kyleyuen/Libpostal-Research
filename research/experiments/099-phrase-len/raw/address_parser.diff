+#ifdef EXP_PHRASE_LEN
+// Experiment 099: cstring_array_get_phrase (trie_search.c) for the context's normalized arrays, with each word's length taken from the cstring index
+// (cstring_array_token_length: next start - start - 1) instead of strlen, and the separator pushed as one byte. The words are normalized tokens of a NUL-terminated
+// input; normalization only emits input bytes, DIGIT_CHAR and spaces, so no word contains a NUL and both lengths agree (EXP_PHRASE_LEN_VERIFY checks).
+static char *ap_get_phrase(cstring_array *str, char_array *out, phrase_t phrase) {
+    char_array_clear(out);
+    size_t phrase_end = phrase.start + phrase.len;
+    for (size_t k = phrase.start; k < phrase_end; k++) {
+        char *w = cstring_array_get_string(str, (uint32_t)k); size_t wl = (size_t)cstring_array_token_length(str, (uint32_t)k);
+#ifdef EXP_PHRASE_LEN_VERIFY
+        if (wl != strlen(w)) { fprintf(stderr, "EXP_PHRASE_LEN_VERIFY MISMATCH %zu vs %zu\n", wl, strlen(w)); abort(); }
+        { static unsigned long long nv = 0; if ((++nv & 0xFFFFF) == 0) fprintf(stderr, "EXP_PHRASE_LEN_VERIFY %llu words ok\n", nv); }
+#endif
+        char_array_append_len(out, w, wl);
+        if (k < phrase_end - 1) char_array_push(out, ' ');
+    }
+    char_array_terminate(out);
+    return char_array_get_string(out);
+}
