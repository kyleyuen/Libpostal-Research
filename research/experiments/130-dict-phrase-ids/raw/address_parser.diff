+static unsigned long long dp_verified = 0;
+__attribute__((destructor)) static void dp_report(void) { fprintf(stderr, "EXP_DP_IDS_VERIFY: %llu table uses checked, 0 mismatches\n", dp_verified); }
+static void dp_verify(uint32_t apt, char *s, size_t sl, const uint32_t *q, uint32_t qn) {
+    static cstring_array *v = NULL; if (v == NULL) v = cstring_array_new(); cstring_array_clear(v);
+    ap_dp_emit(v, apt, s, sl); uint32_t c = 0;
+    for (uint32_t k = 0; k < v->indices->n; k++) { char *ks = cstring_array_get_string(v, k); uint32_t id;
+        if (fd_lookup(dp_dict, ks, strlen(ks), &id)) { if (c >= qn || q[c] != id) { fprintf(stderr, "EXP_DP_IDS_VERIFY MISMATCH phrase='%s'\n", s); abort(); } c++; } }
+    if (c != qn) { fprintf(stderr, "EXP_DP_IDS_VERIFY COUNT MISMATCH phrase='%s'\n", s); abort(); }
+    dp_verified++;
 }
