+void oracle_str(FILE *f, const char *s) {
+    if (s == NULL) { fputs("(null)", f); return; }
+    for (; *s; s++) {
+        unsigned char c = (unsigned char)*s;
+        if (c == '\\') fputs("\\\\", f); else if (c == '\t') fputs("\\t", f); else if (c == '\n') fputs("\\n", f); else if (c == '\r') fputs("\\r", f); else fputc(c, f);
+    }
+}
+static void oracle_member(FILE *f, phrase_array *phrases, int64_array *memberships, size_t i) {
