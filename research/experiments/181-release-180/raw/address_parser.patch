+    if (m < 0 || phrases == NULL || (size_t)m >= phrases->n) { fputs("\t-", f); return; }
+    phrase_t ph = phrases->a[m];
+    fprintf(f, "\t%u,%u,%u", ph.start, ph.len, ph.data);
+}
